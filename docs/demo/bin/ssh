#!/bin/sh
# A stand-in for ssh in docs/demo/workspace.tape: it connects nowhere and
# plays a remote shell for the alias, its last argument, so the recording
# shows a Session without a real host.
for a in "$@"; do alias=$a; done
user=deploy
case $alias in
db-main | staging-db) user=postgres ;;
pi-*) user=pi ;;
nas) user=admin ;;
bastion) user=ops ;;
esac

printf 'Linux %s 6.1.0-28-amd64 #1 SMP Debian x86_64\n\n' "$alias"
printf 'Last login: Tue Nov 24 09:12:44 2026 from 10.20.0.5\n'
while :; do
	printf '\033[32m%s@%s\033[0m:\033[34m~\033[0m$ ' "$user" "$alias"
	IFS= read -r line || exit 0
	case $line in
	"") ;;
	exit) exit 0 ;;
	uptime) echo ' 09:14:02 up 41 days,  3:07,  1 user,  load average: 0.08, 0.12, 0.10' ;;
	ls) echo 'app  backups  deploy.sh  logs' ;;
	*) echo "${line%% *}: command not found" ;;
	esac
done
