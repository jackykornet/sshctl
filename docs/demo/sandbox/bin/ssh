#!/bin/sh
# A stand-in for ssh in docs/demo/*.tape: it connects nowhere and
# plays a remote shell for the alias, its last argument, so the recording
# shows a Session without a real host.
for a in "$@"; do alias=$a; done
# The User of the alias's Host block in the demo ssh_config, as ssh would
# use it.
user=$(cat ~/.ssh/config ~/.ssh/sshctl_config 2>/dev/null | awk -v a="$alias" '
	tolower($1) == "host" { in_block = ($2 == a) }
	in_block && tolower($1) == "user" { print $2; exit }')
: "${user:=user}"

printf 'Linux %s 6.1.0-28-amd64 #1 SMP Debian x86_64\n\n' "$alias"
printf 'Last login: Tue Nov 24 09:12:44 2026 from 10.20.0.5\n'
dir='~'
while :; do
	# Debian's bash sets the window title to user@host: dir, as here.
	printf '\033]0;%s@%s: %s\007' "$user" "$alias" "$dir"
	printf '\033[32m%s@%s\033[0m:\033[34m%s\033[0m$ ' "$user" "$alias" "$dir"
	IFS= read -r line || exit 0
	case $line in
	"") ;;
	exit) exit 0 ;;
	cd) dir='~' ;;
	"cd "*) dir=${line#cd } ;;
	uptime) echo ' 09:14:02 up 41 days,  3:07,  1 user,  load average: 0.08, 0.12, 0.10' ;;
	ls) echo 'app  backups  deploy.sh  logs' ;;
	*) echo "${line%% *}: command not found" ;;
	esac
done
