{
  "name": "Go",
  "image": "mcr.microsoft.com/devcontainers/go:1.25-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "openai.codex",
        "anthropic.claude-code"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": true,
        "go.useLanguageServer": true,
        "editor.formatOnSave": true,
        "[go]": {
          "editor.defaultFormatter": "golang.go"
        }
      }
    }
  },
  "postCreateCommand": "sh .devcontainer/post-create.sh",
  "mounts": [
    "source=sshctl-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=sshctl-gh-${devcontainerId},target=/home/vscode/.config/gh,type=volume",
    "source=sshctl-atlas-config-${devcontainerId},target=/home/vscode/.config/atlas,type=volume",
    "source=sshctl-atlas-data-${devcontainerId},target=/home/vscode/.local/share/atlas,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  }
}
